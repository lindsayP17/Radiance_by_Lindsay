# GEMINI_API_KEY: Required for server-side Outfit Advisor API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Base public URL where this application is hosted.
APP_URL="http://localhost:3000"

# PAYMENT_SIGNING_SECRET: Optional secret used by the backend to sign cryptographic order receipts.
PAYMENT_SIGNING_SECRET="MY_PAYMENT_SIGNING_SECRET"

# STRIPE_SECRET_KEY: Optional Stripe secret key for live Stripe PaymentIntent creation on the server.
STRIPE_SECRET_KEY=""
